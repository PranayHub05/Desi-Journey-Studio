# =====================================================================
# Desi Journey Studio - Environment Configuration Example
# Note: The application is designed to run out of the box with offline/
# local storage persistence and mock/fallback services.
# Add third-party credentials below to enable live production integrations.
# =====================================================================

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Configuration (Optional: defaults to LocalStorage/IndexedDB state)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=desi-journey.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=desi-journey-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=desi-journey.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Gemini API (Optional: used for assisted itinerary suggestions; defaults to curated regional templates)
GEMINI_API_KEY=your_gemini_api_key

# Google Maps Platform (Optional: for live distance matrix and geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Transactional Email Provider (Optional: Resend / SendGrid / SMTP)
# If omitted, proposal email triggers standard client mailto & shareable link
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Desi Journey <quotes@desijourney.in>"

# WhatsApp Cloud API (Optional: WhatsApp Business direct dispatch)
# If omitted, one-click WhatsApp web/app link generation with prefilled text is used
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
